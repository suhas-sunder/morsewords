# Public deployment settings
DOMAIN=www.example.com
APEX_DOMAIN=example.com
IMAGE_NAME=ghcr.io/suhas-sunder/morsewords
IMAGE_TAG=latest
PORT=3000
NODE_ENV=production

# Contact form delivery (runtime only)
RESEND_API_KEY=replace-with-a-resend-api-key
RESEND_FROM_EMAIL=MorseWords <contact@example.com>

# Existing book-content configuration. VITE_ and PUBLIC_ values are build-time
# values; set them as GitHub Actions build secrets/variables only if the current
# production deployment already uses an override.
VITE_MORSE_BOOK_CONTENT_BASE_URL=
PUBLIC_MORSE_BOOK_CONTENT_BASE_URL=
VITE_ENABLE_LOCAL_BOOK_CONTENT_ROUTE=
MORSEWORDS_ENABLE_LOCAL_BOOK_CONTENT_ROUTE=
MORSEWORDS_INTERNAL_ORIGIN=
