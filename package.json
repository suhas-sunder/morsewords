{
  "name": "morsewords",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:netlify": "cross-env NODE_OPTIONS=--max-old-space-size=4096 react-router build",
    "books:build": "node --experimental-strip-types scripts/books/build-book-library.ts",
    "books:apply-review": "node --experimental-strip-types scripts/books/apply-book-review-approvals.ts",
    "books:audit-pass-1": "node --experimental-strip-types scripts/books/audit-book-processing-pass-1.ts",
    "books:audit-pass-2": "node --experimental-strip-types scripts/books/audit-book-processing-pass-2.ts",
    "books:build-previews": "node --experimental-strip-types scripts/books/build-book-previews.ts",
    "books:candidate-report": "node --experimental-strip-types scripts/books/generate-first-publication-candidate-report.ts",
    "books:enrich-metadata": "node --experimental-strip-types scripts/books/enrich-book-metadata.ts",
    "books:rights-report": "node --experimental-strip-types scripts/books/generate-book-rights-reports.ts",
    "books:review-queue": "node --experimental-strip-types scripts/books/generate-book-review-queue.ts",
    "books:scaffold-metadata": "node --experimental-strip-types scripts/books/scaffold-book-metadata.ts",
    "dev": "cross-env NODE_ENV=development node server.js",
    "start": "node server.js",
    "test": "npm run test:smoke",
    "test:e2e": "playwright test",
    "test:fuzz": "playwright test tests/qa-robustness-review/morse-utils.fuzz.spec.ts",
    "test:smoke": "playwright test tests/qa-robustness-review/route-registry.spec.ts tests/qa-robustness-review/route-smoke-core.spec.ts tests/qa-robustness-review/runtime-performance-hardening.spec.ts --project=desktop-chromium",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@react-router/express": "^7.14.2",
    "@react-router/node": "^7.14.2",
    "compression": "^1.7.5",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "isbot": "^5.1.27",
    "morgan": "^1.10.0",
    "pdfjs-dist": "^4.10.38",
    "posthog-js": "^1.279.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.14.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@netlify/vite-plugin-react-router": "^1.0.1",
    "@playwright/test": "^1.59.1",
    "@react-router/dev": "^7.14.2",
    "@tailwindcss/vite": "^4.1.4",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "cross-env": "^7.0.3",
    "fast-check": "^4.7.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
