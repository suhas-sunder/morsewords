{
  "extends": "./tsconfig.json",
  "include": [
    "server.js",
    "vite.config.ts",
    "scripts/books/**/*.ts",
    "app/client/components/shared/morseUtils.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  }
}
